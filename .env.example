# Server-side Postgres (Phase 1 — docker-compose.yml's "postgres" service).
# Only set on the server's .env, never locally. Docker compose reads these
# from .env directly for the service's ${...} substitution, and passes them
# to "app" and "directus" as discrete connection fields (see PGHOST/etc and
# docs/DIRECTUS.md below).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Server-side Directus (Phase 2 — docker-compose.yml's "directus" service).
# Only set on the server's .env. Reuses POSTGRES_DB/USER/PASSWORD above to
# connect — see docs/DIRECTUS.md for why, and the TODO to split it out later.
# KEY/SECRET are Directus's own encryption/signing keys, generated fresh for
# this environment (openssl rand -hex 32) — never copied from a local .env.
# ADMIN_PASSWORD is a THROWAWAY password: the admin UI is HTTP-only until a
# domain + HTTPS exist (see docs/DIRECTUS.md) — rotate it the moment that lands.
DIRECTUS_KEY=
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=

# Catalogue database (Phase 3 — db/client.ts). Required; the app throws at
# startup if any of these is unset. Discrete fields, not a single connection
# string — POSTGRES_PASSWORD can contain characters that aren't safe
# unescaped inside a URL, so this sidesteps ever needing to encode it.
# - Locally: point at an SSH tunnel to the server Postgres (see
#   docs/RESTORE.md for the tunnel pattern), e.g. PGHOST=localhost,
#   PGPORT=5433, PGUSER=woodclay_app, PGDATABASE=woodclay.
# - On the server: NOT set here directly — docker-compose.yml's "app"
#   service sets these inline from POSTGRES_DB/USER/PASSWORD above, the same
#   way the "directus" service does.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Local-only, optional. Used by drizzle-kit (drizzle.config.ts) for
# `db:generate`/`studio`/`migrate` — a single connection-string URL, since
# that's what drizzle-kit's own config expects (unrelated to the app's own
# PGHOST/etc above). Point it at the same SSH tunnel, e.g.
# postgres://woodclay_app:<password>@localhost:5433/woodclay — if the
# password needs URL-encoding for this one, encode it here by hand.
DATABASE_URL=

# Accounts (Phase 4 — auth.ts). AUTH_SECRET signs/encrypts the session JWT —
# generate with `openssl rand -base64 32`, same as DIRECTUS_KEY/SECRET above.
# COOKIE_SECURE must stay "false" while the site is served over plain HTTP
# (the browser silently drops a Secure-flagged cookie on non-HTTPS origins,
# which would break login entirely) — flip to "true" the moment HTTPS lands.
# See docs/DIRECTUS.md's Security TODOs.
AUTH_SECRET=
COOKIE_SECURE=false

# SMTP for email verification codes (lib/mailer.ts). The mailbox
# woodandclay.help@mail.ru is already the support address linked in the
# account page footer — SMTP_USER doubles as the From address (mail.ru
# rejects a mismatched From). Needs an app password, not the account's login
# password: mail.ru → Настройки → Пароль и безопасность → Пароли для
# внешних приложений.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ЮKassa payment (Phase 6 — lib/yookassa.ts). These are a *test shop*'s
# credentials from the ЮKassa dashboard (sandbox) — there is no separate
# sandbox API host, so going live later is only ever swapping these two
# values for the live shop's real ones, nothing else changes. Get them from
# https://yookassa.ru/my (Настройки → тестовый магазин).
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# СДЭК pickup-point picker (Phase 7 — app/api/cdek/cities, app/api/cdek/offices,
# lib/shipping.ts). Own-built list picker, no map/Yandex dependency.
# CDEK_CLIENT_ID/SECRET: OAuth2 client-credentials for СДЭК API v2, from
# "Интеграция" → "Создать ключ" in the СДЭК личный кабинет — works even
# before a full business contract is approved (test-account limitations
# apply: test orders aren't fulfilled). Swap for live values once the
# contract is approved.
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Flat СДЭК ПВЗ-to-ПВЗ shipping rate in rubles — provisional, see
# lib/shipping.ts. One place to change it: edit here, restart the app
# container, no rebuild needed.
SHIPPING_FLAT_RATE_RUB=450

# Telegram bot used to deliver corporate-quote form submissions
# (app/api/corporate-quote/route.ts). Both required for the form to work.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. HTTP proxy URL (e.g. http://xray:1080) for the outbound
# Telegram API call only — needed when api.telegram.org isn't directly
# reachable from the server's network (see docker-compose.yml's xray
# service). Leave unset if the server can reach Telegram directly.
TELEGRAM_PROXY_URL=
