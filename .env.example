# Path to the shared catalog.db SQLite file (outside this repo — see CLAUDE.md).
# Required; the app throws at startup if this is unset. Use forward slashes
# even on Windows (e.g. D:/Wood_Clay/woodclay_web/data/catalog.db).
CATALOG_DB_PATH=

# Telegram bot used to deliver corporate-quote form submissions
# (app/api/corporate-quote/route.ts). Both required for the form to work.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. HTTP proxy URL (e.g. http://xray:1080) for the outbound
# Telegram API call only — needed when api.telegram.org isn't directly
# reachable from the server's network (see docker-compose.yml's xray
# service). Leave unset if the server can reach Telegram directly.
TELEGRAM_PROXY_URL=
