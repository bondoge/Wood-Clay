{
  "name": "woodandclay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "shots": "node scripts/shots.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/apply-migrations.mjs",
    "generate:reviews-grid": "node --env-file=.env scripts/generate-reviews-grid.mjs",
    "migrate:catalog-to-postgres": "node --env-file=.env scripts/migrate-to-postgres.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@electric-sql/pglite": "^0.3.16",
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
